target/
.local/
*.log

.claude/settings.local.json
.codex/hooks.json

# Terraform local working data and operator inputs. Provider lock files stay
# committed so local operators resolve the reviewed provider builds.
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# Per-environment inputs for the production roots are reviewed configuration,
# not operator secrets: project, bucket names, image digests, and numeric secret
# versions. Secret payloads still never enter Terraform.
!**/tfvars/*.tfvars
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
